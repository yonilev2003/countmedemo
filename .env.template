# countme — local environment template
# ----------------------------------------------------------------------
# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored — it should NEVER be committed.
# .env.template (this file) is committed as a reference for new developers.
# ----------------------------------------------------------------------

# === Anthropic Claude API ===
# Used by src/app/api/chat/route.ts (the agent chat).
# Get yours at https://console.anthropic.com/.
# In production, set this as a Vercel environment variable instead.
ANTHROPIC_API_KEY=

# === Supabase ===
# After creating a Supabase project (https://supabase.com), grab these
# from Project Settings → API. The first two are public (sent to the
# browser); the service-role key is server-only and powerful.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# === Auth gating ===
# When "true", the proxy redirects unauthenticated users away from ALL app
# routes (/home, /demo, /setup, /onboarding, /business-expenses, /dashboard,
# /invoices, /coach, /deadlines, /alerts, /file, /receivables) to /login, and
# the AI API routes return 401. Leave unset (or "false") only while the Google
# OAuth provider is not yet enabled in Supabase.
AUTH_GATING_ENABLED=

# === App URL ===
# Canonical public origin (no trailing slash), e.g. https://countmedemo-eight.vercel.app
# Used for OpenGraph metadataBase and the printed-document footer.
NEXT_PUBLIC_APP_URL=

# === Signed public document links (approved by Yoni 2026-07-19) ===
# Long random string used to sign tokenized read-only document links (90-day
# expiry). Server-only. Generate with: openssl rand -hex 32
DOC_LINK_SECRET=

# === Optional: Default model overrides ===
# Sonnet is the default; Haiku is for cheap/fast operations.
# CLAUDE_MODEL_DEFAULT=claude-sonnet-4-6
# CLAUDE_MODEL_CHEAP=claude-haiku-4-5

# === AI cost guard (Yoni's locked decision, 2026-08-18: free-tier + hard caps) ===
# Used by src/lib/ai/usage.ts. Every value below has an in-code default (see
# usage.ts) — set these only to override that default.

# Resend (https://resend.com) sends the immediate threshold-crossing alert
# email (and, later, the daily digest). Free tier: 100 emails/day. Leave
# blank to disable email alerts entirely (usage still gets recorded/aggregated
# and the automatic degrade/pause still runs — only the email is skipped).
RESEND_API_KEY=
# Recipient of every alert email (Yoni's inbox). Required for alerts to send.
ALERTS_EMAIL_TO=
# Optional override for the Resend "from" address. Leave blank to use
# Resend's shared sandbox sender (onboarding@resend.dev) — that sender works
# with zero setup but can only deliver to ALERTS_EMAIL_TO when it's the
# account owner's own verified address. Set this once a real sending domain
# is verified in Resend, e.g. "countme alerts <alerts@countme.co.il>".
ALERTS_EMAIL_FROM=

# Global daily spend (USD, est. from token usage) at which the app
# automatically degrades chat/coach from Sonnet to Haiku. Default: 5.
AI_DAILY_BUDGET_DEGRADE_USD=
# Global daily spend (USD) at which the app automatically pauses AI features
# (chat/coach/upload) with a Hebrew "overloaded, try later" banner. Default: 15.
AI_DAILY_BUDGET_PAUSE_USD=
# Manual kill-switch: "true" pauses all AI features immediately, regardless
# of measured spend. Leave unset/false in normal operation.
AI_PAUSED=
# Manual kill-switch: "true" forces the Sonnet→Haiku degrade immediately,
# regardless of measured spend. Leave unset/false in normal operation.
AI_FORCE_HAIKU=

# Per-user daily request caps (429 with a Hebrew message once exceeded).
# Chat (Eitan) — default: 30/day.
AI_USER_DAILY_CHAT_CAP=
# Coach — default: 30/day.
AI_USER_DAILY_COACH_CAP=
# Document ingestion — shared across /api/upload, /api/parse-expense,
# /api/parse-invoice. Default: 20/day.
AI_USER_DAILY_UPLOAD_CAP=

# === Billing ===
# When "true", paid tracks are enforced and checkout is live. Leave unset/false
# for the free beta — every user is fully entitled and checkout is a no-op.
BILLING_ENABLED=
# --- Tranzila PSP (Israeli) — READY-TO-CONNECT, intentionally NOT live yet. ---
# Leave blank to keep payments disconnected. When these are present the Tranzila
# provider reports isConfigured()=true (still gated by BILLING_ENABLED).
# Server-only — NEVER expose via NEXT_PUBLIC_*. Requires a registered Israeli
# business (עוסק/חברה) to open the terminal. Issues a real חשבונית מס per charge.
TRANZILA_TERMINAL_NAME=
TRANZILA_API_PUBLIC_KEY=
TRANZILA_API_SECRET=
# Override for sandbox; defaults to https://secure5.tranzila.com
TRANZILA_BASE_URL=

# === Cron auth (Vercel Cron → /api/cron/daily-digest) ===
# Vercel automatically sends `Authorization: Bearer <this value>` on its own
# cron invocations once this is set as a project env var — no extra wiring
# needed. Generate with: openssl rand -hex 32. Also lets you trigger the
# digest manually for testing:
#   curl -H "Authorization: Bearer $CRON_SECRET" https://<host>/api/cron/daily-digest
CRON_SECRET=

# === Admin (v2 plan item 3.4 — owner-only realtime stats page) ===
# Comma-separated allowlist of emails permitted to view /admin and its API
# (src/app/api/admin/stats/route.ts). Compared trim/lowercase against the
# signed-in Supabase user's email. Leave unset/empty to disable /admin for
# everyone (fail closed) — a non-admin (or signed-out) request gets a 404,
# never a 401/403, so the route's existence isn't revealed.
ADMIN_EMAILS=

# === Canary rollout flags (v2 plan item 5.3) ===
# Deterministic per-user gradual rollout, since Vercel Hobby has no built-in
# canary deploys — see src/lib/rollout.ts and
# docs/plans/2026-08-18-canary-rollout.md for the full playbook.
# Naming contract: feature "my-feature" -> ROLLOUT_MY_FEATURE_PCT (uppercase,
# non-alphanumeric runs incl. "-" collapse to "_"). Value is 0-100.
# Missing/invalid -> defaults to 100 (fully on) — flags are for CONTAINING
# risky new things, absence must never turn a feature off.
#
# Server-side gating (API routes, server components) — Vercel reads this at
# request time, so editing it takes effect immediately, NO REDEPLOY needed.
# Example (uncomment + rename per feature as needed):
# ROLLOUT_MY_FEATURE_PCT=
#
# Client-side gating (UI rendered in the browser) — Next.js inlines
# NEXT_PUBLIC_* values at BUILD time, so changing this REQUIRES A REDEPLOY
# before it takes effect. Example:
# NEXT_PUBLIC_ROLLOUT_MY_FEATURE_PCT=

# === Canonical site origin (v2 plan item 1.3 — domain migration prep) ===
# Canonical public origin (no trailing slash), e.g. https://countme.co.il.
# Read by getSiteOrigin() in src/lib/site.ts, which falls back to the legacy
# NEXT_PUBLIC_APP_URL (already set in Vercel — see docs/launch/beta-go-live-runbook.md)
# and then to the current live vercel.app domain if neither is set. Next.js
# inlines NEXT_PUBLIC_* at BUILD time, so changing this in Vercel requires a
# redeploy. When Yoni buys a real domain: set this var + update the Supabase
# Auth and Google OAuth console configs in the SAME move (docs/launch/oauth-branding.md)
# — those are external configs this env var cannot reach.
NEXT_PUBLIC_SITE_URL=
