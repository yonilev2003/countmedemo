# countme-crm — local environment template
# ----------------------------------------------------------------------
# Copy to .env.local and fill in your own values.
# .env.local is gitignored. .env.template is committed as documentation.
# Every variable added to .env.local MUST be added here too (with empty value).
# ----------------------------------------------------------------------

# === App ===
# The base URL where this app is hosted. Used for OAuth callbacks,
# invitation links, calendar sync redirects.
# Local: http://localhost:3000
# Production: https://crm.countme.app (or whatever Vercel assigns)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# === Supabase ===
# After creating a Supabase project (https://supabase.com), grab these
# from Project Settings → API.
# - URL and anon key are public (sent to the browser)
# - service-role key is server-only and powerful — never expose to client
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# === Anthropic Claude API ===
# For chat assistant + Gantt vision parsing.
# Get yours at https://console.anthropic.com/.
ANTHROPIC_API_KEY=

# === Google OAuth (Supabase Auth + Calendar API) ===
# Create at https://console.cloud.google.com/apis/credentials
# Add redirect URIs for BOTH:
#   1. Supabase auth callback: https://<your-supabase>.supabase.co/auth/v1/callback
#   2. Calendar OAuth callback: ${NEXT_PUBLIC_APP_URL}/api/calendar/google/callback
# Required scopes: openid, email, profile, https://www.googleapis.com/auth/calendar.events
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === Resend (transactional email for invitations) ===
# https://resend.com — free tier: 3,000/month
RESEND_API_KEY=
# Verified sender. For dev you can use the default "onboarding@resend.dev".
RESEND_FROM_EMAIL=onboarding@resend.dev
