{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "countme Demo Persona",
  "description": "Schema for a persona JSON used to drive the countme demo. Each field can be edited to test the demo with different data without touching code.",
  "type": "object",
  "required": ["id", "displayName", "personal", "business", "income"],
  "properties": {
    "id": { "type": "string" },
    "displayName": { "type": "string" },
    "invoiceCounter": {
      "type": "integer",
      "description": "Next invoice number to use"
    },
    "personal": {
      "type": "object",
      "required": [
        "firstName",
        "lastName",
        "teudatZehut",
        "birthDate",
        "maritalStatus"
      ],
      "properties": {
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "fatherName": { "type": ["string", "null"] },
        "teudatZehut": {
          "type": "string",
          "pattern": "^[0-9]{9}$",
          "description": "9-digit Israeli ID. Validated by israeli-id-validator skill."
        },
        "birthDate": { "type": "string", "format": "date" },
        "maritalStatus": {
          "enum": ["single", "married", "divorced", "widowed", "separated"]
        },
        "spouse": { "type": ["object", "null"] },
        "isNewResident": { "type": "boolean" },
        "isReturningResident": { "type": "boolean" },
        "isEilatResident": { "type": "boolean" },
        "isSoldierDischarged": { "type": "boolean" },
        "soldierDischargeDate": { "type": ["string", "null"] },
        "soldierServiceMonths": {
          "type": ["integer", "null"],
          "description": "Regular military service length in months — drives the discharged-soldier credit's full vs partial per-month rate. Absent/null ⇒ assume full."
        },
        "academicDegreeYear": { "type": ["integer", "null"] },
        "aliyahDate": {
          "type": ["string", "null"],
          "description": "Date of aliyah (ISO format), for עולה חדש/ה credit calculation"
        },
        "reserveDaysByYear": {
          "type": "object",
          "description": "Combat reserve days served, keyed by service year (e.g. \"2025\"). Feeds the מילואים credit (תיקון 283).",
          "additionalProperties": {
            "type": "object",
            "required": ["combatDays"],
            "properties": {
              "combatDays": { "type": "integer" },
              "nonCombatDays": { "type": "integer" }
            }
          }
        }
      }
    },
    "contact": { "type": "object" },
    "business": {
      "type": "object",
      "required": ["tradeName", "primaryOccupation", "osekType"],
      "properties": {
        "osekType": {
          "enum": ["patur", "morshe"],
          "description": "Osek Patur (exempt) / Osek Murshe (registered). Form 1301 is for individuals only — companies file Form 1214 and are out of scope (locked product decision)."
        },
        "isOsekZeir": {
          "type": "boolean",
          "description": "עוסק זעיר — simplified 30% normative-expense track. Only meaningful when osekType is \"patur\"."
        },
        "professionId": {
          "type": "string",
          "description": "Optional link into the expense-engine dataset (lib/expense-engine) — a Profession.id (\"P001\"..\"P113\")."
        }
      }
    },
    "bank": { "type": "object" },
    "income": {
      "type": "object",
      "required": ["year", "totalRevenue", "totalDeductibleExpenses"],
      "properties": {
        "financialInstitutionsIncome": {
          "type": "number",
          "description": "Income from interest/dividends from financial institutions (field 032)"
        },
        "taxWithheldAtSource": {
          "type": "number",
          "description": "Tax withheld at source by clients (field 115)"
        },
        "invoices": {
          "type": "array",
          "description": "List of invoices issued during the tax year",
          "items": {
            "type": "object",
            "required": ["invoiceNumber", "date", "customerName", "description", "amount", "vat", "total"],
            "properties": {
              "invoiceNumber": { "type": "string" },
              "date": { "type": "string", "format": "date" },
              "customerName": { "type": "string" },
              "customerTaxId": { "type": "string" },
              "description": { "type": "string" },
              "amount": { "type": "number" },
              "vat": { "type": "number" },
              "total": { "type": "number" },
              "category": { "type": "string" }
            }
          }
        },
        "expenses": {
          "type": "array",
          "description": "List of business expenses for the tax year",
          "items": {
            "type": "object",
            "required": ["date", "vendorName", "description", "amount", "category", "deductionRule"],
            "properties": {
              "date": { "type": "string", "format": "date" },
              "vendorName": { "type": "string" },
              "description": { "type": "string" },
              "amount": { "type": "number" },
              "vat": { "type": "number" },
              "category": { "type": "string" },
              "receiptPath": { "type": "string" },
              "deductionRule": { "enum": ["full", "partial", "depreciation"] },
              "partialPercent": { "type": "number" }
            }
          }
        }
      }
    },
    "deductionsAndCredits": {
      "type": "object",
      "properties": {
        "lossOfWorkCapacityPremium": {
          "type": "number",
          "description": "Annual premium for loss of work capacity insurance (field 112)"
        }
      }
    },
    "vatAndTurnover": { "type": "object" },
    "journey": {
      "type": "object",
      "description": "Onboarding journey metadata from the lite /onboarding flow (beta, docs/specs/beta/onboarding.md). Optional — absent on any persona created before this flow existed; such personas are treated as fully-experienced via lib/persona.ts getJourney().",
      "required": ["tier", "incomeBand", "onboardingVersion", "onboardingCompletedAt", "filingDetailsCompleted"],
      "properties": {
        "tier": { "enum": ["pre", "first-year", "experienced"] },
        "incomeBand": {
          "enum": ["0-5k", "5-10k", "10-20k", "20k-plus", "irregular", null],
          "description": "Monthly-revenue range — copy-context only, never a calculator input."
        },
        "authorities": {
          "type": "object",
          "description": "Authorities-filing filter answers — present only when tier is \"pre\".",
          "properties": {
            "masHachnasa": { "enum": ["yes", "no", "unsure"] },
            "maam": { "enum": ["yes", "no", "unsure"] },
            "bituachLeumi": { "enum": ["yes", "no", "unsure"] }
          }
        },
        "onboardingVersion": { "enum": ["lite-v1", "legacy"] },
        "onboardingCompletedAt": { "type": "string" },
        "filingDetailsCompleted": { "type": "boolean" }
      }
    }
  }
}
